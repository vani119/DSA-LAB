// Arrray Creation and Display
#include <stdio.h>

int main() {
    int arr[50],n;
    printf("Enter the number of array:");
    scanf("%d",&n);
    printf("Enter the array elements:\n");
    for(int i=0;i<n;i++){
    scanf("%d",&arr[i]);
    }
    printf("Elements of array are:");
    for(int i=0;i<n;i++){
    printf("%d\n",arr[i]);
    }
    return 0;
}
