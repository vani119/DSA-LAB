#include <stdio.h>

int main()
{
    int n,A[n],temp,i,j;
    printf("Enter the value of n:");
    scanf("%d",&n);
    printf("Enter array elements");
    for(i=0;i<n;i++)
    {
        scanf("%d",&A[i]);
    }
        //bubble sort
        for(i=0;i<n-1;i++)
        {
            for(j=0;j<n-1-i;j++)
            {
                if(A[j]>A[j+1])
                {
                    temp = A[j];
                    A[j] = A[j+1];
                    A[j+1] = temp;
                }
            }
        }
        for(i=0;i<n;i++)
        {
            printf("%d ",A[i]);
        }
        return 0;
}

